# Copy to .env for local dev (.env is gitignored). Never commit real secrets.

# Anthropic API key — OPTIONAL. Without it, schema mapping + entity resolution
# fall back to the deterministic path. Read purely from this env var; never hardcoded.
ANTHROPIC_API_KEY=

# SQLite file location. If unset, defaults to backend/app/netting.db (local dev).
# In production point this at a mounted volume so data persists across deploys.
DB_PATH=/data/netting.db

# HTTP port. Injected by the host in production; uvicorn reads it in the Docker CMD.
PORT=8000
